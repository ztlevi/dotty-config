{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "acario-light",
  "font_size": 14,
  "colors": {
    "background": "#f5f5f9",
    "surface": "#fbfbfd",
    "raised": "#ebebf2",
    "hover": "#0000000d",
    "border": "#dcdce6",
    "accent": "#009B7C",
    "foreground": "#0F1019",
    "terminal_foreground": "#0F1019",
    "muted": "#4d5060",
    "dim": "#80838f",
    "selection": "#DEEAF8"
  },
  "background": "#f5f5f9",
  "padding": 0,
  "gap": 0,
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "terminal-acario-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "terminal-acario-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "padding": [
        6,
        6
      ],
      "gap": 8,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 38
          },
          "window_drag": true,
          "content": {
            "mod": "terminal-acario-bar"
          }
        },
        {
          "id": "main",
          "type": "block",
          "content": {
            "tab": "active",
            "pane": {
              "header": {
                "content": {
                  "mod": "terminal-acario-pane"
                },
                "height": 38
              },
              "background": "#fbfbfd",
              "border": {
                "width": 1,
                "color": "#dcdce6"
              },
              "focus": {
                "width": 1,
                "color": "#009B7C"
              },
              "radius": 12,
              "gap": 8,
              "lone": true
            }
          }
        }
      ]
    }
  ],
  "terminal_padding": [
    14,
    12
  ]
}
